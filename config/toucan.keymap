/* Home-row modifiers and six layers ported from the Tornblue keymap. */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define NAV     1
#define MEDIA   2
#define NUM     3
#define SYM     4
#define FUN     5

/ {
    behaviors {
        hml: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Left";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <20 21 22 23>;
            hold-trigger-on-release;
        };
        hmr: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Right";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <14 15 16 17>;
            hold-trigger-on-release;
        };
        mo_layer: behavior_mo_layer {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Symbol Layer / Backspace";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
                &none  &kp Q        &kp W        &kp E         &kp R          &kp T    &kp Y  &kp U          &kp I         &kp O        &kp P          &none
                &none  &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHIFT F  &kp G    &kp H  &hmr RSHIFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SQT  &none
                &none  &kp Z        &kp X        &kp C         &kp V          &kp B    &kp N  &kp M          &kp COMMA     &kp DOT      &kp FSLH       &none
                                &lt MEDIA ESC  &kp RET        &lt NAV TAB    &mo_layer SYM BSPC  &lt NUM SPACE  &lt FUN DELETE
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &none  &trans        &trans    &trans     &trans      &trans    &kp LC(LS(Z))  &kp LC(V)  &kp LC(C)      &kp LC(X)    &kp LC(Z)  &none
                &none  &kp LEFT_GUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &trans    &kp LEFT       &kp DOWN   &kp UP         &kp RIGHT    &kp CAPS   &none
                &none  &trans        &trans    &trans     &trans      &trans    &kp INSERT     &kp HOME   &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &none
                                &kp ESC    &kp RET     &kp TAB    &kp BSPC       &kp SPACE  &kp DELETE
            >;
        };

        media {
            display-name = "MEDIA";
            bindings = <
                &none  &trans        &trans    &trans     &trans      &trans    &bt BT_CLR  &trans          &trans             &trans           &trans        &none
                &none  &kp LEFT_GUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &trans    &trans      &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT    &none
                &none  &trans        &trans    &trans     &trans      &trans    &trans      &bt BT_SEL 0    &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3  &none
                                &kp ESC    &kp RET     &kp TAB    &kp C_STOP  &kp C_PLAY_PAUSE  &kp C_MUTE
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
                &none  &kp LEFT_BRACKET  &kp N7  &kp N8  &kp N9  &kp RIGHT_BRACKET    &trans  &trans      &trans     &trans    &trans    &none
                &none  &kp SEMICOLON     &kp N4  &kp N5  &kp N6  &kp EQUAL            &trans  &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
                &none  &kp GRAVE         &kp N1  &kp N2  &kp N3  &kp BACKSLASH        &trans  &trans      &trans     &trans    &trans    &none
                                &kp DOT  &kp N0  &kp MINUS            &kp BSPC  &kp SPACE   &kp DELETE
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &none  &kp LEFT_BRACE  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE    &trans  &trans      &trans     &trans    &trans    &none
                &none  &kp COLON       &kp DOLLAR     &kp PERCENT   &kp CARET             &kp PLUS           &trans  &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
                &none  &kp TILDE       &kp EXCL       &kp AT        &kp HASH              &kp PIPE           &trans  &trans      &trans     &trans    &trans    &none
                                &kp LPAR      &kp RPAR              &kp UNDERSCORE     &kp BSPC  &kp SPACE   &kp DELETE
            >;
        };

        fun {
            display-name = "FUN";
            bindings = <
                &none  &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN    &trans  &trans      &trans     &trans    &studio_unlock  &none
                &none  &kp F11  &kp F4  &kp F5  &kp F6  &trans       &trans  &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI        &none
                &none  &kp F10  &kp F1  &kp F2  &kp F3  &trans       &trans  &trans      &trans     &trans    &trans          &none
                                &kp K_APP  &kp RET  &kp TAB      &kp BSPC  &kp SPACE   &kp DELETE
            >;
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};

// Ignore touch notifications instead of activating a layer.
&is_touching_processor {
    bindings = <&none>;
};

// Keep trackpad scrolling aligned with this keymap's layer order.
&trackpad_listener {
    scroller {
        layers = <NAV SYM>;
    };
};
